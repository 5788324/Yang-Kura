{
  "name": "yang-kura-audio-library-ui-prototype",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "clean": "node scripts/clean-build-output.mjs",
    "desktop:acceptance-plan": "node scripts/desktop-smoke-check.mjs --checklist",
    "desktop:dev": "npm run build:electron && node scripts/run-electron-dev.mjs",
    "desktop:dist": "npm run build && npm run build:electron && npm run patch:electron-builder && node node_modules/electron-builder/cli.js --win portable nsis --config electron-builder.config.cjs",
    "desktop:pack": "npm run build && npm run build:electron && npm run patch:electron-builder && node node_modules/electron-builder/cli.js --win portable --config electron-builder.config.cjs",
    "desktop:prepare-validation-bundle": "npm run build && npm run build:electron && node scripts/prepare-desktop-validation-bundle.mjs",
    "desktop:preview": "npm run build && npm run build:electron && node scripts/run-electron-preview.mjs",
    "desktop:setup": "node scripts/setup-electron-desktop.mjs",
    "desktop:smoke-check": "node scripts/desktop-smoke-check.mjs",
    "desktop:smoke-check:strict": "node scripts/desktop-smoke-check.mjs --strict-electron",
    "desktop:validate-chain": "npm run verify:env && npm run lint && npm run build:electron && npm run verify:all && npm run build",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "npm run desktop:dev",
    "electron:install": "npm install electron@^39.8.10 --save-dev",
    "lint": "tsc --noEmit",
    "patch:electron-builder": "node scripts/patch-electron-builder-mvp29.mjs",
    "postinstall": "node scripts/patch-electron-builder-mvp29.mjs",
    "preview": "vite preview",
    "test:importer:smoke": "node scripts/smoke-importer-file-ops.mjs",
    "test:index-health:models": "node scripts/test-mvp127-library-index-health-service.mjs",
    "test:library:performance": "node scripts/benchmark-mvp126-large-library.mjs",
    "test:mpv:acceptance": "npm run build:electron --silent && node scripts/mpv-windows-acceptance-check.mjs",
    "test:mpv:settings-runtime": "node scripts/test-mpv-settings-runtime.mjs",
    "test:mpv:stability-runtime": "node scripts/test-mpv-stability-runtime.mjs",
    "test:mpv:windows": "node scripts/mpv-windows-sample-check.mjs",
    "test:mvp128-index-cleanup": "node scripts/test-mvp128-index-cleanup-service.mjs",
    "test:mvp129-index-maintenance": "npm run build:electron --silent && node scripts/test-mvp129-index-maintenance-runtime.mjs",
    "verify:all": "npm run verify:stable",
    "verify:env": "node scripts/verify-env.mjs",
    "verify:handoff": "node scripts/verify-handoff.mjs",
    "verify:stable": "node scripts/run-stable-regression.mjs",
    "test:u28:electron-e2e": "node scripts/test-u28-electron-e2e.mjs",
    "test:u29:electron-e2e": "node scripts/test-u29-electron-e2e.mjs",
    "verify:u29-player-reliability": "node scripts/verify-u29-player-reliability.mjs",
    "test:u30:ui-matrix": "node scripts/test-u30-ui-matrix.mjs",
    "verify:u30-ui-fast-track": "node scripts/verify-u30-ui-fast-track.mjs",
    "test:u31:importer-transactions": "node scripts/test-u31-importer-transactions.mjs",
    "verify:u31-importer-transaction-hardening": "node scripts/verify-u31-importer-transaction-hardening.mjs",
    "verify:u38a-player-session-boundaries": "node scripts/verify-u38a-player-session-boundaries.mjs",
    "audit:k2-r1-library": "node scripts/audit-k2-r1-library.mjs",
    "test:k2-r2:sqlite-node": "node scripts/poc-k2-r2-sqlite.mjs",
    "test:k2-r2:sqlite-electron": "node scripts/run-electron-as-node.mjs scripts/poc-k2-r2-sqlite.mjs",
    "test:k2-r2:catalog": "npm run build:electron --silent && node scripts/test-k2-r2-catalog-database.mjs",
    "test:k2-r2:catalog-electron": "npm run build:electron --silent && node scripts/run-electron-as-node.mjs scripts/test-k2-r2-catalog-database.mjs",
    "test:k2-r2:catalog-sidecar": "npm run build:electron --silent && node scripts/test-k2-r2-catalog-sidecar-worker.mjs",
    "benchmark:k2-r2:catalog-real-scale": "npm run build:electron --silent && node scripts/benchmark-k2-r2-catalog-real-scale.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "Yang-Kura Desktop 2.0: personal Windows RJ/ASMR and music library, focused on 8TB+ scale, mature playback, high-quality UI and future local/cloud sources.",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "optionalDependencies": {
    "electron": "^39.8.10"
  },
  "overrides": {
    "@noble/hashes": "1.4.0"
  }
}
